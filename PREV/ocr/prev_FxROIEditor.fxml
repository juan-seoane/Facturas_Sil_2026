<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="5" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sil.facturas.presentationgui.fxcontrollers.FxROIEditorController">

    <!-- ============================
         TOOLBAR SUPERIOR
         ============================ -->
    <children>
        <ToolBar fx:id="toolbar">
            <items>
            <Button fx:id="btnLoad" mnemonicParsing="false" onAction="#onCargarModelo" text="LOAD" />
                <Button fx:id="btnROI" text="ROI" />
                <ComboBox fx:id="comboCamposOCR" prefWidth="200" promptText="Selecciona campo OCR" />
                <Label fx:id="lblCoords" text="x1,y1 → x2,y2" />
                <Button fx:id="btnAdd" onAction="#onAddROI" text="+" />
                <!-- <Button fx:id="btnOCR" onAction="#onOCRTest" text="OCR TEST"/> -->
                <Button fx:id="btnListo" onAction="#onListo" text="LISTO" />
            </items>
        </ToolBar>

        <!-- ============================
             SCROLLPANE (NO ESTIRA NADA)
             ============================ -->
        <ScrollPane fx:id="scrollPane" fitToHeight="false" fitToWidth="false" pannable="true" VBox.vgrow="ALWAYS">

            <!-- ============================
                 CONTENEDOR DE LA IMAGEN
                 ============================ -->
            <content>
                <Pane fx:id="centerPane" prefHeight="300" prefWidth="400">

                    <!-- Imagen -->
                    <children>
                        <StackPane fx:id="panelOCR" layoutX="20" layoutY="20" style="-fx-background-color: rgba(0,0,0,0.75); -fx-padding: 15; -fx-background-radius: 8;" visible="false">
                            <children>
                                <Label fx:id="lblOCR" maxWidth="300" textFill="white" wrapText="true" />
                            </children>
                        </StackPane>
                        <ImageView fx:id="imageView" pickOnBounds="false" preserveRatio="true" />

                        <!-- Overlay transparente -->
                        <Pane fx:id="overlay" mouseTransparent="false" pickOnBounds="true" style="-fx-background-color: rgba(255,0,0,0.25);" />
                    </children>

                </Pane>
            </content>
        </ScrollPane>
    </children>

</VBox>
