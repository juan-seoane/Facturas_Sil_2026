<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.Group?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sil.facturas.presentationgui.fxcontrollers.FxCntrlModeloOCRVisualizer"
      spacing="0"
      style="-fx-padding:0;">

    <children>

        <ToolBar>
            <Button text="Cargar modelo" onAction="#onCargarModelo"/>
            <Button text="Cargar imagen" onAction="#onCargarImagen"/>
        </ToolBar>

        <Pane fx:id="rootPane" style="-fx-padding:0;">
            <children>
                <Group fx:id="group">
                    <children>
                        <ImageView fx:id="imageView"/>
                        <Pane fx:id="overlayPane" pickOnBounds="false" />
                    </children>
                </Group>
            </children>
        </Pane>

    </children>

</VBox>
